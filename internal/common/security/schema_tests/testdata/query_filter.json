{
  "Query": {
    "$condition": {
      "$eq": [
        {
          "$field": "$sm#semanticId"
        },
        {
          "$strVal": "https://admin-shell.io/idta/nameplate/3/0/Nameplate"
        }
      ]
    },
    "$filters": [
      {
        "$fragment": "$sme#value",
        "$condition": {
          "$eq": [
            {
              "$field": "$sm#semanticId.keys[].value"
            },
            {
              "$strVal": "HIDE_VALUE"
            }
          ]
        }
      },
      {
        "$fragment": "$sm#semanticId.keys[]",
        "$condition": {
          "$eq": [
            {
              "$field": "$sm#semanticId.keys[].value"
            },
            {
              "$strVal": "HIDE_VALUE"
            }
          ]
        }
      }
    ]
  }
}
