{
  "AllAccessPermissionRules": {
    "rules": [
      {
        "ACL": {
          "ACCESS": "ALLOW",
          "RIGHTS": ["READ"],
          "ATTRIBUTES": [{"GLOBAL": "ANONYMOUS"}]
        },
        "OBJECTS": [{"DESCRIPTOR": "$aasdesc(\"*\")"}],
        "FORMULA": {
          "$eq": [
            {"$field": "$aasdesc#specificAssetIds[].externalSubjectId.keys[].value"},
            {"$strVal": "PUBLIC_READABLE"}
          ]
        }
      },
      {
        "ACL": {
          "ACCESS": "ALLOW",
          "RIGHTS": ["READ"],
          "ATTRIBUTES": [{"CLAIM": "role"}]
        },
        "OBJECTS": [{"ROUTE": "/shell-descriptors/*"}],
        "FORMULA": {
          "$and": [
            {
              "$eq": [
                {"$field": "$aasdesc#endpoints[].interface"},
                {"$strVal": "AAS-3.0"}
              ]
            },
            {
              "$eq": [
                {"$attribute": {"CLAIM": "role"}},
                {"$strVal": "viewer"}
              ]
            }
          ]
        }
      },
      {
        "ACL": {
          "ACCESS": "ALLOW",
          "RIGHTS": ["READ", "CREATE", "UPDATE", "DELETE"],
          "ATTRIBUTES": [{"CLAIM": "role"},{"CLAIM": "clear"}]
        },
        "OBJECTS": [{"DESCRIPTOR": "$aasdesc(\"*\")"}],
        "FORMULA": {
          "$and": [
            {
              "$eq": [
                {"$field": "$aasdesc#endpoints[].interface"},
                {"$strVal": "AAS-3.0"}
              ]
            },
            {
              "$or": [
                {"$eq": [ {"$attribute": {"CLAIM": "role"}}, {"$strVal": "editor"} ]},
                {"$eq": [ {"$attribute": {"CLAIM": "role"}}, {"$strVal": "admin"} ]}
              ]
            },
            {
              "$ge": [
                {"$numCast": {"$attribute": {"CLAIM": "clear"}}},
                {"$numVal": 2}
              ]
            }
          ]
        }
      },
      {
        "ACL": {
          "ACCESS": "ALLOW",
          "RIGHTS": ["READ", "CREATE", "UPDATE", "DELETE"],
          "ATTRIBUTES": [{"CLAIM": "role"},{"CLAIM": "clear"}]
        },
        "OBJECTS": [{"DESCRIPTOR": "$aasdesc(\"*\")"}],
        "FORMULA": {
          "$and": [
            {
              "$or": [
                {"$eq": [ {"$attribute": {"CLAIM": "role"}}, {"$strVal": "admin"} ]},
                {"$eq": [ {"$attribute": {"CLAIM": "role"}}, {"$strVal": "editor"} ]}
              ]
            },
            {
              "$ge": [
                {"$numCast": {"$attribute": {"CLAIM": "clear"}}},
                {"$numVal": 10}
              ]
            }
          ]
        }
      }
    ]
  }
}
